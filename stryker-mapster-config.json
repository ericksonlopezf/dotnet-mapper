{
  "stryker-config": {
    "project": "EricksonLopez.Mapper.Mapster.csproj",
    "test-projects": [
      "EricksonLopez.Mapper.Mapster.Tests.csproj"
    ],
    "mutate": [
      "**/*.cs",
      "!bin/**",
      "!obj/**",
      "!**/*.g.cs",
      "!**/*.AssemblyInfo.cs"
    ],
    "thresholds": {
      "high": 100,
      "low": 98,
      "break": 95
    },
    "coverage-analysis": "all",
    "reporters": [
      "html",
      "json",
      "cleartext",
      "progress"
    ],
    "ignore-methods": [
      "ConfigureAwait",
      "Dispose"
    ],
    "concurrency": 2
  }
}
