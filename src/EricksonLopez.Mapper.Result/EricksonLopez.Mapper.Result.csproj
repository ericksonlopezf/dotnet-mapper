    <PackageTags>$(CommonPackageTags);result;result-pattern;functional-programming;railway-oriented-programming;error-handling;monad;extensions</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Mapper.Abstractions\EricksonLopez.Mapper.Abstractions.csproj" />
