# Top-most EditorConfig file
root = true

# All files
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C# files
[*.cs]
# Standard C# formatting and conventions
csharp_indent_braces = false
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_space_after_cast = false
csharp_space_around_binary_operators = before_and_after

dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# ─── Naming Rules ───
dotnet_naming_rule.interface_should_be_prefixed_with_i.symbols = interface_symbols
dotnet_naming_rule.interface_should_be_prefixed_with_i.style = prefix_i_style
dotnet_naming_rule.interface_should_be_prefixed_with_i.severity = warning

dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_symbols.interface_symbols.applicable_accessibilities = *
dotnet_naming_style.prefix_i_style.required_prefix = I
dotnet_naming_style.prefix_i_style.capitalization = pascal_case

dotnet_naming_rule.types_should_be_pascal_case.symbols = type_symbols
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.types_should_be_pascal_case.severity = warning

dotnet_naming_symbols.type_symbols.applicable_kinds = class, struct, enum, delegate, record
dotnet_naming_symbols.type_symbols.applicable_accessibilities = *
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# ─── Analyzer Diagnostic Severities ───
# IDE1006: Naming rule violations
dotnet_diagnostic.IDE1006.severity = warning

# CA1707: Identifiers should not contain underscores
dotnet_diagnostic.CA1707.severity = warning

# CA1852: Seal internal types
dotnet_diagnostic.CA1852.severity = warning

# CA1305: Specify IFormatProvider
dotnet_diagnostic.CA1305.severity = warning

# CS0618 / CS0619: Prohibit Obsolete symbols
dotnet_diagnostic.CS0618.severity = error
dotnet_diagnostic.CS0619.severity = error

# CS0159 / CS159: The label cannot be found / invalid jump target
dotnet_diagnostic.CS0159.severity = error

# xUnit1051: Async fixture lifecycle
dotnet_diagnostic.xUnit1051.severity = warning

# Documentation rules (CS1591, CS1570, CS1572, CS1573, CS1574, CS1587)
dotnet_diagnostic.CS1591.severity = warning
dotnet_diagnostic.CS1570.severity = warning
dotnet_diagnostic.CS1572.severity = warning
dotnet_diagnostic.CS1573.severity = warning
dotnet_diagnostic.CS1574.severity = warning
dotnet_diagnostic.CS1587.severity = warning

# ─── Test Files Configuration ───
# Living specifications under Roy Osherove naming pattern (ADR-021)
# Method_Scenario_ExpectedBehavior allows underscores in test method identifiers
[tests/**.cs]
dotnet_naming_rule.test_methods_should_follow_osherove_pattern.symbols = test_method_symbols
dotnet_naming_rule.test_methods_should_follow_osherove_pattern.style = osherove_test_method_style
dotnet_naming_rule.test_methods_should_follow_osherove_pattern.severity = suggestion

dotnet_naming_symbols.test_method_symbols.applicable_kinds = method
dotnet_naming_symbols.test_method_symbols.applicable_accessibilities = *
dotnet_naming_style.osherove_test_method_style.capitalization = pascal_case
dotnet_naming_style.osherove_test_method_style.word_separator = _

dotnet_diagnostic.CA1707.severity = suggestion
dotnet_diagnostic.CA1305.severity = suggestion
dotnet_diagnostic.CS1591.severity = none

# ─── Benchmark & Sample Files Configuration ───
[{benchmarks,samples}/**.cs]
dotnet_diagnostic.CA1707.severity = suggestion
dotnet_diagnostic.CA1305.severity = suggestion
dotnet_diagnostic.CS1591.severity = none


